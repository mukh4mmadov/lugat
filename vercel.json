{
  "functions": {
    "api/ai-chat.js": {
      "maxDuration": 60
    },
    "api/feedback-ai.js": {
      "maxDuration": 60
    },
    "api/speaking-ai.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "/manifest.webmanifest"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-reminders",
      "schedule": "0 15 * * *"
    }
  ]
}
